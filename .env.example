# Copy this file to .env and fill in your own Supabase project values.
# Found in Supabase dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: only needed if you want the admin dashboard to pull metadata/posters
# straight from TMDB instead of typing them in by hand.
# Get a free key at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=
